{
  "name": "love-code",
  "version": "1.0.0",
  "description": "本地优先 AI 伴侣系统",
  "main": "dist/main/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:main\" \"npm:dev:preload\" \"npm:dev:renderer\" \"npm:start\"",
    "dev:main": "concurrently -k \"tsc -p tsconfig.main.json --watch\" \"tsc-alias -p tsconfig.main.json --watch\"",
    "dev:preload": "concurrently -k \"tsc -p tsconfig.preload.json --watch\" \"tsc-alias -p tsconfig.preload.json --watch\"",
    "dev:renderer": "vite",
    "build": "npm run clean && npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json && tsc-alias -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json && tsc-alias -p tsconfig.preload.json && node -e \"require('fs').copyFileSync('src/preload/package.json','dist/preload/package.json');require('fs').copyFileSync('src/preload/package.json','dist/preload/preload/package.json');\"",
    "build:renderer": "tsc -p tsconfig.renderer.json && vite build",
    "start": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "clean": "rimraf dist out"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "edge-tts": "^1.0.1",
    "electron": "^33.4.11",
    "ollama": "^0.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.23.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.0",
    "rimraf": "^6.0.0",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "wait-on": "^8.0.0"
  }
}
